# Runtime settings for the currently active robot.
# Replace camera_info_vehicle.yaml after calibrating a different camera.
AUTOAIM_CAMERA_INFO_URL='package://hik_camera/config/camera_info_vehicle.yaml'
AUTOAIM_CONFIG_PATH='configs/school.yaml'
AUTOAIM_LOCAL_ONLY='1'

# TensorRT engines are tied to the target TensorRT/GPU runtime and are built on
# the Orin. This source ONNX matches yolov5.xml: [1,3,640,640] -> [1,25200,22].
AUTOAIM_INFER_BACKEND='trt'
AUTOAIM_TRT_ONNX_PATH='/home/hero/RobotDetectionModel-main/Model/0708.onnx'

# Static-target anti-jitter settings. Increase a deadband slightly if one axis
# still chatters; lower the filter alpha for stronger smoothing.
AUTOAIM_CONTROL_FILTER_ALPHA='0.25'
AUTOAIM_YAW_DEADBAND_DEG='0.25'
AUTOAIM_PITCH_DEADBAND_DEG='0.20'

# Fire remains disabled unless scripts/aim is started with the `fire` command.
# These conservative defaults must be tuned with controlled target practice.
AUTOAIM_FIRE_HOLD_S='0.15'
AUTOAIM_FIRE_INTERVAL_S='0.5'
AUTOAIM_FIRE_SHOT_PERIOD_S='0.1'
AUTOAIM_FIRE_BURST_COUNT='3'
AUTOAIM_FIRE_YAW_TOLERANCE_DEG='2.0'
AUTOAIM_FIRE_PITCH_TOLERANCE_DEG='2.0'
AUTOAIM_FIRE_MAX_YAW_VELOCITY_DEG_S='5.0'
AUTOAIM_FIRE_MAX_PITCH_VELOCITY_DEG_S='5.0'
AUTOAIM_FIRE_MAX_REPROJECTION_ERROR_PX='3.0'

# Chessboard parameters used by: bash scripts/aim calibrate
# Size means INNER corners; square is measured in metres.
AUTOAIM_BOARD_SIZE='11x8'
AUTOAIM_SQUARE_SIZE='0.020'
AUTOAIM_CAMERA_NAME='narrow_stereo'
